# MyHOT 설정 파일. .env로 복사해 수정하거나 `node scripts/init-env.ts`를 실행하면 랜덤 시크릿 키가 자동 생성됩니다.
# 프론트엔드는 사이트 URL만 전달받으며, 모든 시크릿 키는 백엔드에만 존재합니다. .env 파일을 Git에 커밋하지 마세요.

# ===== 필수 항목 =====

# 사이트 외부 접속 주소: 생성되는 링크, RSS, 공유 이미지, MCP가 모두 이 주소를 사용합니다. 로컬 테스트 시 아래 기본값을 사용하세요.
SITE_URL=http://localhost:3000

# 관리자 비밀번호(최소 12자 이상), /admin 로그인에 사용됩니다.
ADMIN_PASSWORD=

# 세션 서명 및 이미지 프록시 서명용 시크릿 키 (각각 `openssl rand -hex 32`로 생성한 랜덤 문자열 입력).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Docker 사용 시 PostgreSQL 데이터베이스 비밀번호 (포트는 외부에 열리지 않지만 랜덤 문자열 사용 권장).
POSTGRES_PASSWORD=

# 모델: OpenAI 호환 API면 모두 사용할 수 있으며, 모든 단계의 기본 모델로 적용됩니다. 아래는 DeepSeek 예시입니다.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 공급자별 추가 요청 파라미터(JSON) — 예: 추론(Thinking) 모드 끄기
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 다른 공급자 예시:
#   Qwen:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu:  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# 모델이 이미지 입력(Vision)을 지원하면 활성화하세요 (선별 콘텐츠의 제목·요약 작성 시 대표 이미지 참고):
# LLM_VISION=true
# 공급자가 JSON 모드(response_format)를 지원하지 않을 때 비활성화:
# LLM_JSON_MODE=false
# 추론형 모델(Thinking/Reasoning 모델) 사용 시 추론 출력용 추가 토큰 버퍼(기본값 0).
# “output token limit reached (finish_reason=length)” 오류가 발생할 때 설정하세요:
# LLM_REASONING_TOKENS=4000

# ===== 선택: 사건 클러스터링 정확도 향상 =====

# 벡터 임베딩: OpenAI 호환 /embeddings 엔드포인트. 미설정 시 텍스트 중복도로 후보를 찾지만,
# 화제성 신호 전용(hot_signal) 토론 게시물이 사건에 연결되지 않아 화제성 지수가 낮아질 수 있습니다.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 또는 Alibaba DashScope 키만 입력하면 text-embedding-v4를 사용합니다:
# DASHSCOPE_API_KEY=
# 임베딩 벡터 차원(EMBEDDING_* 사용 시 기본값은 응답 자동 감지, DashScope 기본 1024). 변경 시 기존 벡터가 재계산됩니다:
# EMBEDDING_DIMS=

# ===== 선택: 단계별 모델 개별 지정 =====
# 기본적으로 모든 단계에 위 LLM_* 설정이 적용됩니다. 특정 단계만 다른 모델을 쓰려면 프리셋 이름과 해당 키를 설정하세요:
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 프리셋 이름 및 필요한 키:
#   deepseek-flash / deepseek-flash-think           DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection         ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                                 XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 주의: EMBEDDING_API_KEY 없이 DASHSCOPE_API_KEY만 설정하면 클러스터링이 자동으로 DashScope 임베딩(text-embedding-v4)을 사용하며 별도 과금됩니다.

# ===== 선택: 유료 수집 서비스 (요청당 과금, 관리자 "설정"에서 예산 서킷 브레이커 조정 가능) =====
# X(트위터) 계정 수집: SocialData
# SOCIALDATA_API_KEY=
# 위챗 공중계정 수집: Dajiala(다자라)
# DAJIALA_KEY=
# 본문 추출 실패 시 브라우저 렌더링 폴백: Jina Reader
# JINA_API_KEY=

# ===== 선택: Feishu(Lark) 연동 =====
# 주요 정세 선정 소식을 Feishu 그룹에 푸시(T1, T1_5 정보원의 선정 기사만): 관리자 "설정 → 알림 대상"에서 활성화하고 웹훅 주소 입력.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 시스템 장애 알림 및 피드백을 내부 Feishu 그룹으로 전달(피드백 전달은 Feishu 자체 앱 필요):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 텍스트 전용 알림을 그룹 커스텀 봇으로 보낼 수도 있습니다: 이 값을 설정하면 위 앱/채팅방 ID 대신 웹훅으로 전송합니다.
# FEISHU_ALERT_WEBHOOK_URL=
# 알림을 자체 자동 처리 서비스(예: AI 호출 Webhook 중계 허브)로 먼저 전달합니다. 두 항목 모두 설정하고 FEISHU_INTERNAL_ENABLED=true일 때 동작:
# 처리 대상 알림은 이 주소로 POST(Authorization: Bearer <KEY>, JSON 필드 id, type, subject, summary, detail, link)되며 200 응답 시 수락 처리;
# 운영자 직접 알림·복구·시스템 일보는 동일 호스트 루트의 /tell(JSON 필드 key, text)로 먼저 전송 후 실패 시 Feishu로 폴백합니다. 자세한 동작은 docs/deploy.md 참조.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# Feishu 계정으로 관리자 로그인 (선택, 비밀번호 로그인과 병행 가능):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 선택: 기타 =====
# GitHub API(api.github.com) 기반 JSON 정보원 사용 시 호출 한도 상향용 토큰 (읽기 전용 권한으로 발급):
# GITHUB_TOKEN=
# 외부 스크립트로 기사 푸시(POST /api/ingest/items) 시 사용하는 토큰(최소 16자 이상). 미설정 시 해당 API 비활성화.
# INGEST_TOKEN=
# 외부 푸시 API 클라이언트당 분당 요청 제한(Docker Compose 기본값 10). 앞단 리버스 프록시가 제한할 경우 0으로 설정 가능:
# INGEST_RATE_LIMIT=10
# 해외 정보원 수집 시 아웃바운드 프록시가 필요한 경우:
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 내부 사설망에 구축된 서비스(예: 같은 Docker 네트워크의 RSSHub)를 구독할 때 전체 호스트명을 쉼표로 구분해 지정(대소문자 무관, 와일드카드 미지원).
# 해당 피드 주소 자체에만 프록시 없이 직접 연결을 허용하며, 리다이렉트 대상 호스트·기사 본문·이미지는 여전히 내부망 접속이 차단됩니다:
# PRIVATE_FEED_HOSTS=rsshub
# 이미지 프록시가 원본 사이트에서 가져오는 트래픽 상한(분당 MB, 일일 GB). 초과 시 캐시되지 않은 이미지는 503을 반환하며 미설정 시 site/site.ts의 DEPLOYMENT.imageUpstreamBudget를 따릅니다:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# 앞단에 Caddy 또는 Nginx 등 리버스 프록시가 있으면 true로 설정하여 X-Forwarded-For에서 방문자 IP를 읽습니다.
# 직접 외부에 노출할 때는 로그인·피드백 제한 우회를 막기 위해 false를 유지하세요.
TRUST_PROXY=false
# MCP는 SITE_URL 도메인(및 localhost) 요청만 허용합니다. 추가 허용 도메인이 있으면 쉼표로 구분해 입력:
# MCP_ALLOWED_HOSTS=
# 신규 기사가 지정 시간(분) 동안 수집되지 않으면 "수집 중단" 경보를 발송합니다. 미설정 시 site/site.ts의 ALERTS.quietMinutes(기본 360) 적용:
# ALERT_QUIET_MINUTES=360
# 매일 새 페이지를 IndexNow(Bing 등)에 제출. 키는 32자리 16진수 문자열로 직접 생성하세요:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 매일 데이터베이스를 S3 호환 오브젝트 스토리지(AWS S3, Cloudflare R2, MinIO, COS 등)로 백업합니다.
# DB_BACKUP_STORE_DOMAIN을 비워 두면 COS 형식(<버킷>.cos.<리전>.myqcloud.com)을 사용하며,
# AWS S3 등 타 서비스 사용 시 버킷명이 포함된 도메인(예: my-bucket.s3.us-east-1.amazonaws.com)을 입력하세요:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 로그 레벨(기본 info) 및 DB 커넥션 풀 상한(기본 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# 릴리즈 버전명: 관리자 "실행" 페이지 및 /api/health에 표시되어 배포 반영 여부를 확인할 수 있습니다:
# AIHOT_RELEASE=
# 환경 이름: 기본값은 NODE_ENV(production 또는 development). production이 아니면 알림에 환경명이 포함되며 개발 무인증 모드가 허용됩니다:
# AIHOT_ENVIRONMENT=
# 자격 증명 그룹 파일(models.env, collectors.env, integrations.env, auth.env)을 모아 둔 디렉터리 경로(여기 지정된 환경변수가 우선함):
# AIHOT_CREDENTIALS_DIR=

# ===== 안전 밸브 =====
# 소문자 true로 설정해야만 정보원 수집(매일 아이콘 갱신 포함)과 모델 호출이 실행됩니다. UI 디버깅 시에는 false로 끄세요.
# 이 파일의 모든 *_ENABLED 스위치는 소문자 true만 활성으로 인정하며 1, yes, TRUE 등은 비활성으로 처리됩니다.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Docker 없이 로컬 호스트에서 직접 실행할 때만 필요 =====
# DATABASE_URL=postgres://사용자명@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# 업로드 파일, 이미지 캐시 및 로컬 백업 저장 디렉터리(기본값: 저장소 내 .data):
# AIHOT_DATA_DIR=/var/lib/myhot
# 개발 환경에서 로그인 없이 관리자 페이지에 접근(프로덕션에서는 기동 거부), 관리자 표시 이름:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# 로컬 디버깅 시 사설망 주소 수집 허용(기본 금지, 프로덕션에서는 기동 거부):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== docker compose --profile https 사용 시 =====
# SITE_DOMAIN=example.com
# 로컬 포트 바인딩(docker compose 기본값 3000). HTTPS 사용 시 로컬 Caddy 전용으로 제한하고 외부 직접 노출을 막으세요:
# PORT=127.0.0.1:3000
# (동시에 위 TRUST_PROXY를 true로 변경하세요)
